<%/* Robbo: «Удалить группу» next to the title (js/groups/views/cohort_editor.js deleteGroup), not for the default
  group (the only automatic one); no «What does this mean?» links */%>
<div class="robbo-cohort-header-row">
    <h3 class="hd hd-3 group-header-title" tabindex="-1">
        <span class="title-value"><%- cohort.get('name') %></span>
        <span class="group-count"><%-
            interpolate(
                ngettext('(contains %(student_count)s student)', '(contains %(student_count)s students)', cohort.get('user_count')),
                { student_count: cohort.get('user_count') },
                true
            )
        %></span>
    </h3>
    <% if (!isDefaultCohort) { %>
    <button type="button" class="button action-secondary robbo-cohort-delete"><%- gettext('Delete the group') %></button>
    <% } %>
</div>
<div class="cohort-management-group-setup">
    <div class="setup-value">
        <% if (cohort.get('assignment_type') == "manual") { %>
            <%- gettext("Learners are added to this cohort only when you provide their email addresses or usernames on this page.") %>
        <% } else { %>
            <%- gettext("Learners are added to this cohort automatically.") %>
            <% if (isDefaultCohort) { %>
            <%- gettext("This is the default group: everyone not placed in another group comes here, so it cannot be deleted.") %>
            <% } %>
        <% } %>
    </div>
</div>
