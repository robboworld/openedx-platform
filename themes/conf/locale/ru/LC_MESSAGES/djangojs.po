msgstr[0] "{total_results} найден результат для \"{search_term}\""
msgstr[1] "{total_results} результатов найдено для \"{search_term}\""
msgstr[2] "{total_results} результатов найдено для \"{search_term}\""
msgstr[3] "{total_results} результатов найдено для \"{search_term}\""

#: openedx/features/learner_profile/static/learner_profile/js/learner_profile_factory.js
