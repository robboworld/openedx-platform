"свой дополнительный адрес электронной почты."

#: lms/static/js/student_account/views/account_settings_factory.js
msgid "Social Media Links"
msgstr "Ссылки на социальные сети"

#: lms/static/js/student_account/views/account_settings_factory.js
msgid ""
"Optionally, link your personal accounts to the social media icons on your "
"edX profile."
msgstr ""
"При желании свяжите свои личные учетные записи со значками социальных сетей "
"в своем профиле edX."

#: lms/static/js/student_account/views/account_settings_factory.js
msgid ""
"Enter your {platform_display_name} username or the URL to your "
"{platform_display_name} page. Delete the URL to remove the link."
msgstr ""
"Введите свое имя пользователя {platform_display_name} или URL-адрес вашей "
"страницы {platform_display_name}. Удалите URL-адрес, чтобы удалить ссылку."

#: lms/static/js/student_account/views/account_settings_factory.js
msgid ""
"You can link your social media accounts to simplify signing in to "
"{platform_name}."
msgstr ""
"Вы можете связать свои учетные записи в социальных сетях, чтобы упростить "
"вход в {platform_name}."

#: lms/static/js/student_account/views/account_settings_factory.js
msgid "ORDER NAME"
msgstr "НАЗВАНИЕ ЗАКАЗА"

#: lms/static/js/student_account/views/account_settings_factory.js
msgid "ORDER PLACED"
msgstr "ЗАКАЗ РАЗМЕЩЕН"

#: lms/static/js/student_account/views/account_settings_factory.js
msgid "TOTAL"
msgstr "ОБЩИЙ"

#: lms/static/js/student_account/views/account_settings_factory.js
msgid "ORDER NUMBER"
msgstr "НОМЕР ЗАКАЗА"

#: lms/static/js/student_account/views/account_settings_factory.js
msgid "My Orders"
msgstr "Мои заказы"

#: lms/static/js/student_account/views/account_settings_factory.js
msgid ""
"This page contains information about orders that you have placed with "
"{platform_name}."
msgstr ""
"Эта страница содержит информацию о заказах, которые вы разместили у "
"{platform_name}."

#: lms/static/js/student_account/views/account_settings_fields.js
msgid ""
"We've sent a confirmation message to {new_email_address}. Click the link in "
"the message to update your email address."
msgstr ""
"Мы отправили сообщение с подтверждением на адрес {new_email_address}. "
"Нажмите ссылку в сообщении, чтобы обновить свой адрес электронной почты."

#: lms/static/js/student_account/views/account_settings_fields.js
msgid ""
"You must sign out and sign back in before your language changes take effect."
msgstr ""
"Вам необходимо выйти и снова войти в систему, прежде чем изменения языка "
"вступят в силу."

#: lms/static/js/student_account/views/account_settings_fields.js
msgid ""
"We've sent a message to {email}. Click the link in the message to reset your"
" password. Didn't receive the message? Contact {anchorStart}technical "
"support{anchorEnd}."
msgstr ""
"Мы отправили сообщение на {email}. Нажмите ссылку в сообщении, чтобы "
"сбросить пароль. Не получили сообщение? Обратитесь в службу "
"{anchorStart}технической поддержки{anchorEnd}."

#: lms/static/js/student_account/views/account_settings_fields.js
msgid "Link your {accountName} account"
msgstr "Привяжите свою учетную запись {accountName}"

#: lms/static/js/student_account/views/account_settings_fields.js
msgid "Unlink This Account"
msgstr "Отсоединить эту учетную запись"

#: lms/static/js/student_account/views/account_settings_fields.js
msgid ""
"You can use your {accountName} account to sign in to your {platformName} "
"account."
msgstr ""
"Вы можете использовать свою учетную запись {accountName} для входа в свою "
"учетную запись {platformName}."

#: lms/static/js/student_account/views/account_settings_fields.js
msgid "Unlink your {accountName} account"
msgstr "Отключите свою учетную запись {accountName}"

#: lms/static/js/student_account/views/account_settings_fields.js
msgid ""
"Link your {accountName} account to your {platformName} account and use "
"{accountName} to sign in to {platformName}."
msgstr ""
"Свяжите свою учетную запись {accountName} со своей учетной записью "
"{platformName} и используйте {accountName} для входа в {platformName}."

#: lms/static/js/student_account/views/account_settings_fields.js
msgid "Unlinking"
msgstr "Отмена связи"

#: lms/static/js/student_account/views/account_settings_fields.js
msgid "Linking"
msgstr "Связывание"

#: lms/static/js/student_account/views/account_settings_fields.js
msgid "Successfully unlinked."
msgstr "Связь успешно отменена."

#: openedx/features/course_search/static/course_search/js/views/search_results_view.js
